    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u044D\u0442\u0430\u043F\n\u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
    \u0434\u0432\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B, \u043A\u043B\u0430\u0434\u043E\u0432\u0443\u044E
    \u0438 \u0434\u0435\u0433\u0443\u0441\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u0441\u0442\u043E\u043B.\n\u0413\u043E\u0442\u043E\u0432\u043A\u0430 \u0438
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0440\u0430\u0443\u043D\u0434
    \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
    \u0441\u0440\u0435\u0437\u0435."
