    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "WASD \u2014 \u0445\u043E\u0434\u044C\u0431\u0430 \xB7 Shift \u2014 \u0431\u0435\u0433
    \xB7 \u043C\u044B\u0448\u044C \u2014 \u043E\u0431\u0437\u043E\u0440\nTab \u2014
    \u043A\u043E\u0440\u0437\u0438\u043D\u0430 \xB7 E \u2014 \u0432\u0437\u044F\u0442\u044C
    / \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C / \u043D\u0430\u0433\u0440\u0435\u0432\n\u041B\u041A\u041C
    \u2014 \u043D\u0430\u0440\u0435\u0437\u0430\u0442\u044C / \u0440\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u0430\u0442\u044C
    / \u043C\u0435\u0448\u0430\u0442\u044C / \u0434\u043E\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \xB7 G \u2014 \u0443\u0440\u043E\u043D\u0438\u0442\u044C\nRMB \u2014 \u043E\u0442\u043C\u0435\u043D\u0430
    \xB7 Q \u2014 \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \xB7 Esc \u2014 \u043F\u0430\u0443\u0437\u0430"
